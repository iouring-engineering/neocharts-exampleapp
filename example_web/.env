# Base URL the compiled SDK web bundle (flutter.js, main.dart.js, assets/)
# is served from. Defaults to the local build_web symlink used by dev/CI
# builds -- override at build time to point at a CDN instead, e.g.:
#   VITE_SDK_ASSET_BASE=https://cdn.nxtoption.com/neocharts-sdk/ npm run build
# CDN mode assumes the bundle hosted there is the SDK's `-cdn` tarball
# variant, which fetches CanvasKit from Google's gstatic.com itself --
# CanvasKit is never served relative to this base (see ChartMount.tsx).
VITE_SDK_ASSET_BASE=/build_web/
#VITE_SDK_ASSET_BASE=https://cdn.nxtoption.com/neocharts-sdk/
